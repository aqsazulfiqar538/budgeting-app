<div class="min-h-screen w-full bg-gray-100">
  <nav class="bg-white shadow px-6 py-4 flex justify-between items-center">
    <h1 class="text-xl font-bold text-gray-800">Budgeting App</h1>
    <div class="flex items-center gap-4">
      <%= link_to "Dashboard", dashboard_path, class: "text-sm text-blue-600 hover:underline" %>
      <span class="text-sm text-gray-600">Hello, <%= current_user.first_name %></span>
      <%= button_to "Logout", destroy_user_session_path, method: :delete,
          class: "bg-red-500 hover:bg-red-600 text-white text-sm px-4 py-2 rounded-lg cursor-pointer transition duration-200" %>
    </div>
  </nav>

  <div class="max-w-2xl mx-auto px-4 py-10">
    <h2 class="text-2xl font-bold text-gray-800 mb-6">New Expense</h2>

    <div class="bg-white border border-gray-200 rounded-xl p-6">
      <%= render "form", expense: @expense %>
    </div>

    <div class="mt-4">
      <%= link_to "Back to Expenses", expenses_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
    </div>
  </div>
</div>