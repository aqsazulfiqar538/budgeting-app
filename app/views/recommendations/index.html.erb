<%= turbo_frame_tag "category_panel" do %>
  <div class="py-6">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-2xl font-bold text-gray-800 capitalize">
        <%= @category %> Recommendations
      </h2>
      <%= link_to "Ask AI",
            new_recommendation_path(category: @category),
            class: "bg-blue-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-blue-700",
            data: { turbo_frame: "category_panel" } %>
    </div>

    <div id="recommendations_list" class="flex flex-col gap-3">
      <% if @recommendations.empty? %>
        <p class="text-gray-400 text-sm text-center py-10">
          No recommendations yet. Ask the AI for advice!
        </p>
      <% else %>
        <% @recommendations.each do |rec| %>
          <%= render "recommendation_card", recommendation: rec %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
