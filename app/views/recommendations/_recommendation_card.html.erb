<div id="<%= dom_id(recommendation) %>"
     class="bg-white border border-gray-200 rounded-xl p-4 hover:shadow-sm transition">
  <div class="flex items-start justify-between">
    <div class="flex-1">
      <div class="flex items-center gap-2 mb-1">
        <span class="text-xs font-semibold px-2 py-0.5 rounded-full">
          <%= recommendation.action_label %>
        </span>
      </div>
      <p class="text-gray-700 font-medium text-sm"><%= recommendation.summary %></p>
      <% if recommendation.estimated_savings != "N/A" %>
        <p class="text-green-600 text-xs mt-1"> Save <%= recommendation.estimated_savings %></p>
      <% end %>
    </div>
    <%= link_to "View →",
          recommendation_path(recommendation),
          class: "text-sm text-indigo-600 font-medium hover:underline shrink-0 ml-4" %>
  </div>
</div>
